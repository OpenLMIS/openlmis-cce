{
  "service": {
    "Name": "cce",
    "Id": "cce-service",
    "Port": 8080,
    "Tags": ["openlmis-service"],
    "check": {
      "interval": "10s",
      "http": "http://HOST:PORT/actuator/health",
      "timeout": "5s"
    }
  },
  "raml": "/consul/api-definition.yaml",
  "path": [
    "cce",
    "cce/docs",
    "cce/docs/<all>",
    "cce/webjars",
    "cce/webjars/<all>"
  ]
}
